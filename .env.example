# Secret key (S...) of the landing account that receives anchor deposits and
# signs router.dispatch. SERVER/RELAYER ONLY — never expose it to the browser,
# never prefix it with NEXT_PUBLIC_.
LANDING_SECRET=

# Written by scripts/deploy.sh; the deployer only registers routes.
DEPLOYER_SECRET=

# Comma-separated origins allowed to nudge the hosted relay from a browser.
# Origins only — scheme and host, no path. Without the deployed example app's
# origin here, its pledges reach the chain only when the relay next runs.
STELLO_ALLOWED_ORIGINS=http://localhost:3001,https://stello-core-et2a.vercel.app
